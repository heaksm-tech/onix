# Copy to .env — docker compose reads it automatically.
# The API's DATABASE_URL is assembled from the POSTGRES_* values by compose;
# you do not set it here.

# --- Database ---
POSTGRES_USER=onix
POSTGRES_PASSWORD=onix
POSTGRES_DB=onix_dev

# --- Host ports (change if something already owns these) ---
POSTGRES_PORT=5432
API_PORT=4000
WEB_PORT=3000

# --- API ---
LOG_LEVEL=debug
# Browser origins allowed to call the API directly. Empty on purpose — browser
# traffic goes through the web app's own /api/v1 route, never cross-origin.
CORS_ORIGIN=

# --- Sessions ---
# How long a sign-in lasts.
SESSION_TTL_DAYS=14
# Defaults to on in production; set to false when the *web app* is served over
# plain HTTP, or the browser will discard the session cookie.
# SESSION_COOKIE_SECURE=false

# --- Email (Resend) ---
# API key used by both development and production. Without it, development
# still runs but reports that the password-change notification was not sent.
RESEND_API_KEY=
# Development uses Resend's onboarding@resend.dev sender and this safe test
# recipient. Set it to the email address attached to your Resend account when
# you want the message delivered to your own inbox.
RESEND_DEV_TO=delivered+password-change@resend.dev
# Production only: an address at the domain you verified in Resend. Compose
# refuses to start the production API while this or RESEND_API_KEY is empty.
RESEND_FROM_EMAIL=

# --- Web ---
# Nothing to configure: the web app reaches the API over the compose network,
# and the browser is never told where the API lives.
