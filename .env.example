# Copy to .env — docker compose reads it automatically.
# The API's DATABASE_URL is assembled from the POSTGRES_* values by compose;
# you do not set it here.

# --- Database ---
POSTGRES_USER=onix
POSTGRES_PASSWORD=onix
POSTGRES_DB=onix_dev

# --- Host ports (change if something already owns these) ---
POSTGRES_PORT=5432
API_PORT=4000
WEB_PORT=3000

# --- API ---
LOG_LEVEL=debug
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000

# --- Web ---
# The URL the *browser* uses to reach the API. Server components use the
# internal compose address (http://api:4000/api/v1) and need no configuration.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
