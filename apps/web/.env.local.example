# Local (non-Docker) development only.
#
#   cp .env.local.example .env.local
#
# Next.js loads .env.local automatically. The Docker stack does NOT use it —
# .dockerignore keeps it out of the image and compose injects these values,
# pointing at the internal http://api:4000 address instead.

# Used by server components.
API_URL=http://localhost:4000/api/v1

# Used by browser code. Inlined into the client bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
