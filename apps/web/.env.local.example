# Local (non-Docker) development only.
#
#   cp .env.local.example .env.local
#
# Next.js loads .env.local automatically. The Docker stack does NOT use it —
# .dockerignore keeps it out of the image and compose injects these values,
# pointing at the internal http://api:4000 address instead.

# Where this app reaches the API. Server-side only, and never inlined into the
# client bundle: browser code calls this app's own /api/v1 route, which
# forwards here. That is why there is no NEXT_PUBLIC_* value to set — the
# browser is never told where the API lives.
API_URL=http://localhost:4000/api/v1
