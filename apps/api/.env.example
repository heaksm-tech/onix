# Local (non-Docker) development only.
#
#   cp .env.example .env
#
# The Docker stack does NOT use this file — .dockerignore keeps it out of the
# image, and compose injects these values instead. That is deliberate: the same
# npm scripts work in both worlds without changing behaviour.

# --- Database ---
# Connects as your OS user over the local socket, which matches a default
# Homebrew or Postgres.app install on macOS.
DATABASE_URL=postgres://localhost:5432/onix_dev

# If your PostgreSQL uses password auth, use the full form instead:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/onix_dev

# Tests use "<name>_test" derived from the above (onix_dev -> onix_test).
# Uncomment only to point tests somewhere else entirely.
# TEST_DATABASE_URL=postgres://localhost:5432/onix_test

# --- Server ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Browser origins allowed to call this API directly. Deliberately empty: the
# web app calls the API from the server, and browser traffic goes through the
# web app's own /api/v1 route, so nothing needs cross-origin access. Filling
# this in re-opens the API to browsers.
CORS_ORIGIN=

# --- Sessions and invitations ---
# How long a sign-in lasts. Sessions are server-side rows, so lowering this
# only affects new sign-ins; existing ones keep the expiry they were issued.
SESSION_TTL_DAYS=14

# Public web origin placed in account-invitation links. Required in production.
APP_URL=http://localhost:3000
# How long an unused account-invitation link remains valid.
ACCOUNT_INVITATION_TTL_HOURS=48

# Marks the session cookie Secure. Defaults to on when NODE_ENV=production.
# The cookie reaches the browser via the web app, so what matters is how the
# browser reaches *that* — set this to false for a production deployment
# served over plain HTTP, or the browser drops the cookie silently.
# SESSION_COOKIE_SECURE=false

# --- Email (Resend) ---
# Optional in development so a fresh clone still starts. Invitations report a
# delivery error without it; password changes still succeed but report that
# their notification could not be sent; due reminders retry and eventually
# remain failed without sending an email.
RESEND_API_KEY=

# Used only with NODE_ENV=production. Set an address at the exact domain (or
# subdomain) verified in Resend; the API adds the "Onix CRM" display name.
# Required in production together with RESEND_API_KEY.
RESEND_FROM_EMAIL=
